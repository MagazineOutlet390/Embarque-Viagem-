# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BREVO_API_KEY: Chave da API v3 do Brevo para inscrição na newsletter (server-side secret).
# Configure nas variáveis de ambiente do Cloudflare Pages (Pages -> Settings -> Environment variables).
BREVO_API_KEY=""

# Domínio Oficial & Indexação (Cloudflare Pages — preencher apenas após conectar o domínio definitivo)
# Exemplo no lançamento:
# VITE_PUBLIC_SITE_URL="https://embarqueviagem.com"
# VITE_ENABLE_INDEXING="true"
VITE_PUBLIC_SITE_URL=""
VITE_ENABLE_INDEXING="false"
